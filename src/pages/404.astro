---
import HUD from '../layouts/HUD.astro';
---
<HUD title="Signal lost" active={null}>
  <div class="lost">
    <p class="code">404</p>
    <h1>Signal lost</h1>
    <p>This page doesn't exist, or it moved when the site was rebuilt.</p>
    <a class="btn btn--solid" href="/">Return to the start screen</a>
  </div>
</HUD>
<style>
  .lost { display: grid; justify-items: center; text-align: center; gap: 0.8rem; padding: 4rem 0; }
  .code { margin: 0; font-family: var(--font-display); font-size: clamp(5rem, 14vw, 10rem); line-height: 0.85; color: var(--accent); }
  h1 { font-size: var(--step-3); }
</style>
