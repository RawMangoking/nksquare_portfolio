---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import HUD from '../../layouts/HUD.astro';
import Icon from '../../components/Icon.astro';
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const main = all.filter((p) => p.data.kind === 'main');
const side = all.filter((p) => p.data.kind === 'side');
---
<HUD title="Creations" active="creations" description="Robotics, IoT and machine-learning projects by Narenkarthik Kesavamoorthy.">
  <h1 class="stage-title">Creations</h1>

  <ul class="grid">
    {main.map((p) => (
      <li class="card">
        <a href={`/creations/${p.id}/`} class="card-link" data-sfx>
          <div class="frame brackets">
            {p.data.cover && <Image src={p.data.cover} alt={p.data.coverAlt ?? ''} widths={[360, 560, 720]} sizes="(max-width: 760px) 90vw, 360px" class="cover" />}
            {p.data.status === 'active' && <span class="flag">Active quest</span>}
          </div>
          <h2>{p.data.cardTitle ?? p.data.title}</h2>
          <p class="brief">{p.data.brief}</p>
          {p.data.highlight && (
            <p class="hl"><b>{p.data.highlight.value}</b> {p.data.highlight.label}</p>
          )}
          <span class="open">Open file <Icon name="arrow-right" /></span>
        </a>
      </li>
    ))}
  </ul>

  <section class="side" aria-labelledby="side-title">
    <h2 id="side-title" class="label">Side quests:</h2>
    <ul>
      {side.map((p) => (
        <li class="box">
          <h3>{p.data.title}</h3>
          <p>{p.data.brief}</p>
          <p class="tech">{p.data.tech.join(', ')}</p>
          {p.data.repo && <a class="repo" href={p.data.repo} target="_blank" rel="noopener">View on GitHub <Icon name="github" /></a>}
        </li>
      ))}
    </ul>
  </section>
</HUD>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1.6rem; }
  .card-link { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: var(--soft); border-bottom: 2px solid var(--accent); padding-bottom: 0.8rem; }
  .frame { position: relative; padding: 8px; }
  .cover { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 20%; background: #0a0909; filter: saturate(0.9); transition: filter 0.2s; }
  .card-link:hover .cover { filter: saturate(1.1) brightness(1.08); }
  .flag { position: absolute; left: 8px; top: 8px; background: var(--accent); color: var(--on-accent); font-family: var(--font-display); text-transform: uppercase; font-size: var(--step--1); padding: 0.1rem 0.45rem; }
  .card-link h2 { font-size: var(--step-2); color: var(--accent); margin: 0.6rem 0 0.3rem; }
  .brief { font-family: var(--font-label); font-size: var(--step--2); letter-spacing: 0.06em; text-transform: uppercase; line-height: 1.6; color: var(--soft); }
  .hl { margin: 0 0 0.6rem; font-size: var(--step--1); color: var(--muted); }
  .hl b { font-family: var(--font-display); font-weight: 800; font-size: var(--step-1); color: var(--green); margin-right: 0.2rem; }
  .open { margin-top: auto; display: inline-flex; align-items: center; gap: 0.3rem; font-family: var(--font-display); text-transform: uppercase; color: var(--text); }
  .card-link:hover .open { color: var(--accent); }
  .side { margin-top: 3rem; }
  .side > h2 { color: var(--text); margin-bottom: 0.7rem; }
  .side ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.8rem; }
  .side h3 { font-size: var(--step-1); }
  .tech { color: var(--muted); font-family: var(--font-label); font-size: 0.6875rem !important; letter-spacing: 0.1em; text-transform: uppercase; margin: 0; }
  .side li { display: flex; flex-direction: column; }
  .repo { margin-top: 0.8rem; display: inline-flex; align-items: center; gap: 0.4rem; align-self: flex-start; font-family: var(--font-display); text-transform: uppercase; color: var(--accent); text-decoration: none; }
  .repo:hover { text-decoration: underline; }
</style>
