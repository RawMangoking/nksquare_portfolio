};
---
<svg class={`icon ${cls}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true" focusable="false" set:html={paths[name]} />
<style>
  .icon { width: 1.2em; height: 1.2em; flex: none; }
</style>
