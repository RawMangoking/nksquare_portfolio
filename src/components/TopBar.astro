---
import { profile } from '../data/site';
import { achievements } from '../data/achievements';
const unlocked = achievements.filter((a) => a.status === 'achieved').length;
---
<header class="topbar">
  <div class="stats">
    <p class="stat"><b>{profile.cgpa}</b><span>CGPA</span></p>
    <a class="plus" href="/achievements/" aria-label="Open achievements" data-sfx>+</a>
    <p class="stat"><b>{unlocked}</b><span>Achievements unlocked</span></p>
  </div>
  <div class="meta">
    <button type="button" class="link" data-open="dlg-credits">Credits</button>
    <p class="clock" title="Time on my VPS in Sofia, read from the server's own clock">
      <span>Server time:</span> <time id="clock-server">--:--</time>
    </p>
    <p class="clock">
      <span>Local time:</span> <time id="clock-local">--:--</time>
    </p>
  </div>
</header>

<style>
  .topbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.4rem 0 1.4rem; }
  .stats { display: flex; align-items: center; gap: 1.6rem; }
  .stat { margin: 0; display: flex; align-items: baseline; gap: 0.35rem; }
  .stat b { font-family: var(--font-display); font-weight: 800; font-size: var(--step-3); color: var(--green); line-height: 1; }
  .stat span { font-family: var(--font-display); font-size: var(--step-0); text-transform: uppercase; color: var(--soft); }
  .plus {
    display: grid; place-items: center; width: 2.1rem; height: 2.1rem;
    border: 1px solid var(--soft); color: var(--text); text-decoration: none;
    font-family: var(--font-display); font-size: var(--step-2); line-height: 1;
  }
  .plus:hover { border-color: var(--accent); color: var(--accent); }
  .meta { display: flex; align-items: center; gap: 2.2rem; }
  .link { background: none; border: 0; padding: 0; cursor: pointer; font-family: var(--font-label); font-size: var(--step--2); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text); }
  .link:hover { color: var(--accent); }
  .clock { margin: 0; font-family: var(--font-label); font-size: var(--step--2); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .clock time { color: var(--text); font-variant-numeric: tabular-nums; }
  @media (max-width: 760px) {
    .stats { gap: 0.8rem; }
    .stat b { font-size: var(--step-2); }
    .stat span { font-size: var(--step--1); }
    .clock { display: none; }
    .meta { gap: 0; }
  }
  @media (max-width: 420px) { .stat:last-child span { display: none; } }
</style>
