---
import type { CollectionEntry } from 'astro:content';
interface Props { entries: CollectionEntry<'logs'>[]; heading?: string }
const { entries, heading = 'Older logs:' } = Astro.props;
---
{entries.length > 0 && (
  <section class="older" aria-labelledby="older-title">
    <h2 id="older-title" class="label">{heading}</h2>
    <ul>
      {entries.map((e) => (
        <li><a href={`/logs/${e.id}/`} data-sfx><span>Log entry: {e.data.title}, {e.data.org}</span><span>Date: {e.data.period}</span></a></li>
      ))}
    </ul>
  </section>
)}
<style>
  .older { max-width: 900px; margin: 3rem auto 0; }
  .older h2 { color: var(--text); margin-bottom: 0.6rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  a {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 0.3rem 0.6rem;
    border: 1px solid rgb(var(--accent-rgb) / 0.6); color: var(--accent); text-decoration: none;
    font-family: var(--font-display); font-size: var(--step-0); text-transform: uppercase;
  }
  a:hover { background: rgb(var(--accent-rgb) / 0.12); }
  a span:last-child { font-family: var(--font-label); font-size: var(--step--2); letter-spacing: 0.12em; }
</style>
